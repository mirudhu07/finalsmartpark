# SmartPark AI — Environment Configuration

# Backend REST API
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smartpark
JWT_SECRET=smartpark_dev_jwt_secret_key_9921_replace_in_production
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=smartpark_dev_refresh_token_secret_key_8842_replace_in_production
